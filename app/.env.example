# Base URL of the ACE backend API, reachable FROM YOUR PHONE.
#
# `localhost` will NOT work from a physical device: use your PC's LAN IP
# (run `ipconfig` on Windows -> IPv4 Address), make sure Django/Docker binds
# 0.0.0.0:8000 and add a Windows Defender Firewall inbound rule for TCP 8000.
# Android emulator alternative: http://10.0.2.2:8000/api/v1
# USB-connected Android alternative: `adb reverse tcp:8000 tcp:8000` then http://127.0.0.1:8000/api/v1
# See the repo README ("Mobile dev on Windows") for details.
#
# PRODUCTION: this file is for local development only. Release builds read the
# value from the EAS build profile (see eas.json + DEPLOY.md) and REFUSE to
# start without it — they no longer fall back to localhost. Use an https:// URL
# there; iOS App Transport Security blocks cleartext http:// on device.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api/v1

# --- Legal pages (App Store BLOCKERS) ---
# Apple requires BOTH reachable from inside the app, and a privacy-policy URL
# is a mandatory App Store Connect field — you cannot submit without one.
# Must be https (ATS blocks cleartext on device). The rows/links hide
# themselves when these are unset, so a dev build shows no dead links.
# Apple's standard EULA is an acceptable Terms of Use:
#   https://www.apple.com/legal/internet-services/itunes/dev/stdeula/
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
