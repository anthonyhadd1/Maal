# --- Django backend ---
SECRET_KEY=dev-secret-change-me
DEBUG=1
DJANGO_SETTINGS_MODULE=config.settings.dev
DATABASE_URL=postgres://ace:ace@db:5432/ace
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=1
TIME_ZONE=Asia/Beirut
MEDIA_ROOT=/data/media

# Seed French demo content + demo users + dev superuser (admin/Admin123!) on startup
DEMO_SEED=1

# --- Game economy (server-authoritative defaults; see docs/design_gameplay.md appendix) ---
HEARTS_MAX=5
HEARTS_REGEN_MINUTES=240
HEARTS_GRACE_DAYS=3
REVIEW_HEARTS_PER_DAY=2
STAR_THRESHOLDS=60,80,100
XP_PER_CORRECT=2
XP_PERFECT_BONUS=10
XP_FIRST_CLEAR_BONUS=10
XP_REPLAY_PER_CORRECT=1
XP_REPLAY_PERFECT_BONUS=5
SCORED_REPLAYS_PER_DAY=3
LEGENDARY_MIN_SCORE_PCT=90
LEGENDARY_XP=40
LEAGUE_GROUP_SIZE=30
LEAGUE_PROMOTE_COUNT=10
LEAGUE_DEMOTE_COUNT=5
LEAGUE_DAILY_XP_CAP=1500
CHALLENGE_EXPIRY_HOURS=48
CHALLENGE_XP_WIN=20
CHALLENGE_XP_LOSE=5
CHALLENGE_XP_TIE=10
CHALLENGES_SCORED_PER_DAY=5
FREE_UNITS_PER_SUBJECT=1

